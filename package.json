{
  "name": "nova381-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:server": "node --test tests/server/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
