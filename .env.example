# Default: academic demonstration with fictional passages and no payment.
# Use official for the original portal or api for a configured backend.
# Set api only after configuring API CORS and a reCAPTCHA key for your domain.
VITE_SEARCH_MODE=demo
VITE_API_URL=https://api.nova381.com
VITE_RECAPTCHA_SITE_KEY=
VITE_OFFICIAL_PORTAL_URL=https://pedagioeletronico.nova381.com
VITE_ACCOUNT_URL=https://app.nova381.com

# Server-only: free account token from https://datahub.falcon-server.com.br/register
# Never prefix this variable with VITE_. Restart npm run dev after configuring it.
VEHICLE_API_TOKEN=
